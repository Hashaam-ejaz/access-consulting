---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro"
import Section from "../components/Section.astro"
import Heading from "../components/Heading.astro"

const whatsapp = "4915772312591"

// [CLIENT TO CONFIRM] — must match the footer's office list
const offices = [
    {
        flag: "🇩🇪",
        city: "Frankfurt, Germany",
        lines: ["Bromstraße, Frankfurt"],
    },
    {
        flag: "🇵🇰",
        city: "Gujranwala, Pakistan",
        lines: [
            "First Floor (above Bundu Khan)",
            "Prisma Mall, Cantt",
            "Gujranwala",
        ],
    },
    {
        flag: "🤝",
        city: "FES — Local Partner Office",
        lines: [
            "Office No 104-104A",
            "1st Floor, Kohistan Tower",
            "Mehfooz Shaheed Road, Saddar, Rawalpindi",
        ],
        link: { label: "Visit FES", href: "https://www.fespak.com/" },
    },
]

const contactMethods = [
    {
        title: "Start Your Application",
        desc: "Fill out our structured form. Tell us your profile, goals, and timeline — we'll come back with a clear recommendation and next steps.",
        ctaLabel: "Begin Application →",
        href: "/consulting#evaluate",
        primary: true,
    },
    {
        title: "Chat on WhatsApp",
        desc: "Prefer a quick message first? Drop us a WhatsApp and we'll respond within a few hours. Available in German and Urdu too.",
        ctaLabel: "Open WhatsApp →",
        href: `https://wa.me/${whatsapp}`,
    },
    {
        title: "Book a Free Call",
        desc: "Schedule a 15-minute video call with an advisor. We'll assess your profile and give you an honest view of your options.",
        ctaLabel: "Schedule a call →",
        href: "https://linktr.ee/accessventure130", // [CONFIRM booking link]
    },
]
---

<BaseLayout
    title="Contact — Access Consulting"
    description="Get in touch with Access Consulting — offices in Germany and Pakistan. Start your application, message us on WhatsApp, or book a call.">
    <!-- hero -->
    <Section class="bg-linear-to-b from-[#ece7ff] to-white">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >Begin Your Global Journey Today.</Heading
        >
        <p class="mx-auto max-w-3xl text-center text-lg text-ink/70 md:text-xl">
            Whether you're ready to apply or just have a question, there's a way
            to reach us that suits you.
        </p>
    </Section>

    <!-- three ways to engage -->
    <Section class="bg-white">
        <div class="grid w-full gap-6 lg:grid-cols-3">
            {
                contactMethods.map((m) => (
                    <div
                        class={`flex h-full flex-col rounded-2xl border p-6 ${m.primary ? "border-primary/40 bg-primary/5" : "border-ink/10 bg-white"}`}>
                        <h3 class="text-lg font-semibold text-ink">
                            {m.title}
                        </h3>
                        <p class="mt-2 flex-1 text-sm text-ink/70">{m.desc}</p>
                        <a
                            href={m.href}
                            class={`mt-6 block rounded-full px-6 py-2.5 text-center text-sm font-medium transition-colors ${m.primary ? "bg-primary text-white hover:bg-primary2" : "bg-ink text-white hover:bg-primary"}`}>
                            {m.ctaLabel}
                        </a>
                    </div>
                ))
            }
        </div>
    </Section>

    <!-- direct contact -->
    <Section class="bg-sky-soft">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >Direct Contact</Heading
        >
        <div class="mt-10 grid w-full max-w-3xl gap-6 sm:grid-cols-3">
            <a
                href="tel:+4915772312591"
                class="rounded-2xl border border-ink/10 bg-white p-6 text-center transition-colors hover:border-primary/40">
                <div
                    class="text-sm font-medium uppercase tracking-widest text-primary">
                    Germany
                </div>
                <div class="mt-2 font-medium text-ink">+49 157 7231 2591</div>
            </a>
            <a
                href="tel:+923390123777"
                class="rounded-2xl border border-ink/10 bg-white p-6 text-center transition-colors hover:border-primary/40">
                <div
                    class="text-sm font-medium uppercase tracking-widest text-primary">
                    Pakistan
                </div>
                <div class="mt-2 font-medium text-ink">0339-0123777</div>
            </a>
            <a
                href="mailto:[CLIENT TO CONFIRM]"
                class="rounded-2xl border border-ink/10 bg-white p-6 text-center transition-colors hover:border-primary/40">
                <div
                    class="text-sm font-medium uppercase tracking-widest text-primary">
                    Email
                </div>
                <div class="mt-2 font-medium text-ink">[official email]</div>
            </a>
        </div>
    </Section>

    <!-- offices -->
    <Section class="bg-white">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >Our Offices</Heading
        >
        <div class="mt-10 grid w-full gap-6 md:grid-cols-3">
            {
                offices.map((o) => (
                    <div class="rounded-2xl border border-ink/10 bg-white p-6">
                        <div class="text-2xl">{o.flag}</div>
                        <h3 class="mt-3 font-semibold text-ink">{o.city}</h3>
                        <address class="mt-2 space-y-0.5 text-sm not-italic text-ink/70">
                            {o.lines.map((line) => (
                                <div>{line}</div>
                            ))}
                        </address>
                        {o.link && (
                            <a
                                href={o.link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-3 inline-block text-sm font-medium text-primary hover:underline">
                                {o.link.label} →
                            </a>
                        )}
                    </div>
                ))
            }
        </div>
    </Section>
</BaseLayout>
