---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Section from "../../components/Section.astro"
import { getPosts, getPost } from "../../lib/sanity"
import { toHTML } from "@portabletext/to-html"

export async function getStaticPaths() {
    const posts = await getPosts()
    return posts.map((p: any) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const post = await getPost(slug!)
const bodyHtml = toHTML(post.body)
---

<BaseLayout
    title={`${post.title} — Access Consulting`}
    description={post.excerpt}>
    <Section class="bg-linear-to-b from-[#ece7ff] to-white">
        <div class="mx-auto max-w-3xl text-center">
            <span
                class="text-sm font-semibold uppercase tracking-widest text-primary">
                {post.category}
            </span>
            <h1
                class="mt-3 text-3xl font-semibold tracking-tight text-ink md:text-4xl">
                {post.title}
            </h1>
            <p class="mt-4 text-ink/50">
                {
                    new Date(post.publishedAt).toLocaleDateString("en-GB", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                    })
                }
            </p>
        </div>
    </Section>
    <Section class="bg-white">
        <article class="prose prose-lg mx-auto max-w-3xl" set:html={bodyHtml} />
    </Section>
</BaseLayout>
