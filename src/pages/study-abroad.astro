---
// src/pages/study-abroad.astro
import BaseLayout from "../layouts/BaseLayout.astro"
import Section from "../components/Section.astro"
import Heading from "../components/Heading.astro"
import Button from "../components/Button.astro"
import InfoCard from "../components/InfoCard.astro"
import StepCard from "../components/StepCard.astro"
import FactCard from "../components/FactCard.astro"
import VideoEmbed from "../components/VideoEmbed.astro"

const lastVerified = "July 2026" // update whenever figures are re-checked

const whatsappNumber = "4915772312591"

const advantages = [
    {
        icon: "🏛️",
        title: "Tuition-free public universities",
        desc: "Most German public universities charge no tuition fees — only a modest semester contribution.",
    },
    {
        icon: "💼",
        title: "18-month post-study work visa",
        desc: "Graduates get 18 months to find employment matching their qualification.",
    },
    {
        icon: "🛂",
        title: "Clear PR timeline",
        desc: "A structured route from student status to permanent residency for those who stay and work.",
    },
    {
        icon: "🌍",
        title: "Globally ranked degrees",
        desc: "German qualifications are recognised and respected across the EU and beyond.",
    },
]

const roadmap = [
    {
        step: 1,
        title: "Intake planning",
        desc: "Winter and summer intake windows have different deadlines and programme availability. We map your timeline backwards from the intake you're targeting.",
    },
    {
        step: 2,
        title: "ECTS credit mapping",
        desc: "Your Pakistani degree is assessed against the European credit system to confirm eligibility for your target programmes.",
    },
    {
        step: 3,
        title: "VPD via uni-assist",
        desc: "Preliminary documentation review through uni-assist, including the VPD where your target university requires it.",
    },
    {
        step: 4,
        title: "Application assembly",
        desc: "Programme shortlisting, document preparation, and submission against each university's specific requirements.",
    },
]

const visaSteps = [
    {
        step: 1,
        title: "Admission letter",
        desc: "Confirmed offer from your German university.",
    },
    {
        step: 2,
        title: "Financial proof",
        desc: "Blocked account confirmation or equivalent proof of funds.",
    },
    {
        step: 3,
        title: "Health insurance",
        desc: "Valid coverage confirmation accepted by the embassy.",
    },
    {
        step: 4,
        title: "Motivation letter & documents",
        desc: "Complete file preparation for the German Embassy in Islamabad or Consulate in Karachi.",
    },
    {
        step: 5,
        title: "Appointment & interview",
        desc: "Booking, preparation, and submission support through to decision.",
    },
]

const markets = [
    {
        id: "europe",
        icon: "🇪🇺",
        title: "Wider Europe",
        desc: "Pathways into Italy, France, and Austria — including regional scholarship schemes that significantly reduce cost of study.",
        meta: "Italy · France · Austria",
    },
    {
        id: "north-america",
        icon: "🇨🇦",
        title: "North America",
        desc: "Intake guidelines and application strategy for the USA and Canada, with advisory from our North America partner.",
        meta: "Advised by Usman Hayat",
    },
    {
        id: "australia",
        icon: "🇦🇺",
        title: "Australia",
        desc: "Subclass 500 student visas and regional post-study work pathways, including regional incentives.",
        meta: "Advised by Danish Obaid",
    },
]

const roadmaps = [
    {
        id: "karachi",
        label: "Karachi Consulate",
        image: "/roadmap/summer-2027-karachi.png",
        alt: "German university admissions roadmap for Summer 2027 via the Karachi Consulate",
    },
    {
        id: "islamabad",
        label: "Islamabad Embassy",
        image: "/roadmap/summer-2027-islamabad.png",
        alt: "German university admissions roadmap for Summer 2027 via the Islamabad Embassy",
    },
]
---

<BaseLayout
    title="Study Abroad — Access Consulting"
    description="World-class education and tailored admissions strategies for Germany, Europe, North America, and Australia.">
    <!-- hero -->
    <Section class="bg-linear-to-b from-[#ece7ff] to-white">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >World-Class Education. Tailored Admissions Strategies.</Heading
        >
        <p class="mx-auto max-w-3xl text-center text-lg text-ink/70 md:text-xl">
            From tuition-free German public universities to Australian
            post-study pathways — we map the route that fits your profile, not a
            generic checklist.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <Button href="/about?intent=study-abroad#evaluate"
                >Get your profile evaluated</Button
            >
            <Button href="#germany" variant="secondary"
                >Explore Germany pathways</Button
            >
        </div>
    </Section>

    <!-- Germany: advantage -->
    <Section id="germany" class="bg-white">
        <span
            class="text-sm font-medium uppercase tracking-widest text-primary">
            Flagship focus
        </span>
        <Heading class="mt-3 text-center md:text-4xl lg:text-5xl"
            >The German Advantage</Heading
        >
        <div class="mt-10 grid w-full gap-6 md:grid-cols-2 lg:grid-cols-4">
            {advantages.map((a) => <InfoCard {...a} />)}
        </div>
    </Section>

    <!-- Germany: roadmap -->
    <Section class="bg-sky-soft">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >Comprehensive Admissions Roadmap</Heading
        >
        <div class="mt-10 w-full max-w-2xl">
            {roadmap.map((s) => <StepCard {...s} />)}
        </div>
    </Section>

    <!-- Germany: financial framework -->
    <Section class="bg-white">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >Financial Framework</Heading
        >
        <p class="mx-auto mb-10 max-w-2xl text-center text-ink/70">
            The three financial requirements every German student visa
            application rests on.
        </p>

        <div class="grid w-full gap-6 lg:grid-cols-3">
            <FactCard
                title="Blocked account (Sperrkonto)"
                highlight="€11,904 / year"
                note="Reviewed annually by the German government. Figure current for 2026.">
                <ul class="space-y-2">
                    <li>
                        Released monthly at a fixed <strong>€992/month</strong> —
                        you can't withdraw the full amount at once or vary the monthly
                        figure.
                    </li>
                    <li>
                        Fully operational providers: <strong>Expatrio</strong> and
                        <strong>Fintiba</strong>.
                    </li>
                    <li class="text-sm text-ink/50">
                        Note: the Opportunity Card (Chancenkarte) has a higher
                        requirement — see the Careers & Work Visas page.
                    </li>
                </ul>
            </FactCard>

            <FactCard
                title="Health insurance"
                highlight="~€141 / month"
                note="Public rate for 2026, including long-term care insurance.">
                <ul class="space-y-2">
                    <li>
                        <strong>Public</strong> (TK, AOK, Barmer, DAK): the default
                        for degree-track students under 30, and what the embassy expects.
                    </li>
                    <li>
                        <strong>Private</strong> (Mawista, DR-WALTER, ottonova): required
                        if you're over 30, or in a language/prep course before formal
                        enrolment.
                    </li>
                    <li>
                        Rule of thumb: under 30 + direct degree admission →
                        public. Over 30 or pre-enrolment → private, then switch
                        once enrolled.
                    </li>
                </ul>
            </FactCard>

            <FactCard
                title="Student work rights"
                highlight="140 full days / year"
                note="Resets every 1 January on a calendar-year basis.">
                <ul class="space-y-2">
                    <li>
                        <strong>140 full days or 280 half days</strong> per year (a
                        full day is 4+ hours; days can be mixed).
                    </li>
                    <li>
                        20 hours/week during term; full-time during breaks, but
                        those days still count.
                    </li>
                    <li>
                        Degree-required internships don't count; voluntary
                        internships and mini-jobs do.
                    </li>
                </ul>
            </FactCard>
        </div>

        <p class="mt-8 text-center text-sm text-ink/50">
            Figures last verified {lastVerified}. Requirements are set by German
            authorities and can change — we confirm current rules for every
            client individually.
        </p>
    </Section>

    <!-- Germany: visa mechanics -->
    <Section class="bg-sky-soft">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >Visa Processing Mechanics</Heading
        >
        <p class="mx-auto mb-10 max-w-2xl text-center text-ink/70">
            Your documentation path through the German Embassy in Islamabad or
            the Consulate in Karachi.
        </p>
        <div class="w-full max-w-2xl">
            {visaSteps.map((s) => <StepCard {...s} />)}
        </div>
        <Button href="/about?intent=study-abroad#evaluate" class="mt-6"
            >Schedule a Germany-specific evaluation</Button
        >
    </Section>

    <!-- secondary markets -->
    <Section class="bg-white">
        <Heading class="text-center md:text-4xl lg:text-5xl"
            >Beyond Germany</Heading
        >
        <p class="mx-auto mb-10 max-w-2xl text-center text-ink/70">
            Advisors with lived experience in each destination — not a
            one-size-fits-all playbook.
        </p>
        <div class="grid w-full gap-6 lg:grid-cols-3">
            {
                markets.map((m) => (
                    <div id={m.id}>
                        <InfoCard {...m} />
                    </div>
                ))
            }
        </div>
    </Section>

    <Section class="bg-white" id="roadmap">
        <Heading class="text-center md:text-3xl lg:text-4xl"
            >The German Admissions Roadmap</Heading
        >
        <p class="mx-auto mt-4 max-w-2xl text-center text-ink/70">
            Your full timeline from documentation to enrolment — mapped by
            intake and by mission.
        </p>

        <!-- tabs -->
        <div class="mt-8 flex justify-center gap-2">
            {
                roadmaps.map((r, i) => (
                    <button
                        data-roadmap-tab={r.id}
                        class={`rounded-full px-5 py-2 text-sm font-medium bg-primary/10`}>
                        {r.label}
                    </button>
                ))
            }
        </div>

        <!-- panels -->
        <div class="mt-8 w-full">
            {
                roadmaps.map((r, i) => (
                    <div
                        data-roadmap-panel={r.id}
                        class={i === 0 ? "" : "hidden"}>
                        <img
                            src={r.image}
                            alt={r.alt}
                            class="mx-auto w-full max-w-5xl rounded-2xl border border-ink/10"
                            loading="lazy"
                        />
                    </div>
                ))
            }
        </div>
    </Section>

    <!-- IELTS sub-section -->
    <Section class="bg-blue-100" id="ielts">
        <div class="grid w-full items-center gap-10 lg:grid-cols-2">
            <div>
                <span
                    class="text-sm font-medium uppercase tracking-widest text-primary">
                    IELTS Preparation
                </span>
                <Heading class="mt-3 text-left md:text-3xl lg:text-4xl"
                    >IELTS Prep with Aisha Ghilani</Heading
                >
                <p class="mt-4 text-ink/70">
                    Structured preparation across all four bands — Listening,
                    Reading, Writing, and Speaking — with custom mock
                    assessments and target-score strategies.
                </p>
                <ul class="mt-5 space-y-2 text-ink/80">
                    <li>· 4-band structured preparation</li>
                    <li>· Custom mock assessments</li>
                    <li>· Target-score strategies</li>
                </ul>
                <div class="mt-6 text-2xl font-semibold text-primary">
                    PKR 35,000 <span class="text-base font-normal text-ink/60">
                        flat fee
                    </span>
                </div>
                <Button
                    href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hi, I'd like to book IELTS prep with Aisha.")}`}
                    class="mt-6">
                    Book IELTS Prep with Aisha
                </Button>
            </div>
            <VideoEmbed
                fileId="1-7gyIyK6r_CAMcHwvxpDTys_FGgZp6OO"
                poster="/videos/aisha-ielts-poster.jpg"
                title="Aisha's IELTS intro"
            />
        </div>
    </Section>

    <Section class="bg-sky-soft">
        <div class="mx-auto max-w-3xl text-center">
            <span
                class="text-sm font-medium uppercase tracking-widest text-primary">
                On-ground partner
            </span>
            <Heading class="mt-3 text-center md:text-3xl lg:text-4xl"
                >Supported locally in Pakistan by FES</Heading
            >
            <p class="mt-4 text-ink/70">
                Our official on-ground partner for Germany and EU pathways,
                giving applicants face-to-face support without leaving Pakistan.
            </p>
            <Button
                href="https://www.fespak.com/"
                variant="secondary"
                class="mt-6"
                target="_blank">
                Visit FES
            </Button>
        </div>
    </Section>

    <!-- closing CTA -->
    <Section class="bg-ink text-white">
        <div class="max-w-2xl text-center">
            <h2 class="text-3xl font-semibold md:text-4xl">
                Ready to map your international timeline?
            </h2>
            <p class="mt-4 text-lg text-white/70">
                Share your profile and we'll come back with the pathways that
                actually fit it.
            </p>
            <Button href="/about?intent=study-abroad#evaluate" class="mt-8"
                >Get started</Button
            >
        </div>
    </Section>
</BaseLayout>
