---
const { name, constraint, intervention, outcome } = Astro.props
---

<div class="rounded-2xl border border-ink/10 bg-white p-6 md:p-8">
    <h3 class="text-lg font-semibold text-ink">{name}</h3>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div>
            <div
                class="text-xs font-semibold uppercase tracking-widest text-ink/40">
                The starting point
            </div>
            <p class="mt-2 text-sm text-ink/70">{constraint}</p>
        </div>
        <div class="md:border-l md:border-ink/10 md:pl-6">
            <div
                class="text-xs font-semibold uppercase tracking-widest text-primary">
                What we did
            </div>
            <p class="mt-2 text-sm text-ink/70">{intervention}</p>
        </div>
        <div class="md:border-l md:border-ink/10 md:pl-6">
            <div
                class="text-xs font-semibold uppercase tracking-widest text-green-600">
                The outcome
            </div>
            <p class="mt-2 text-sm text-ink/70">{outcome}</p>
        </div>
    </div>
</div>
