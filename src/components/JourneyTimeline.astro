---
// src/components/JourneyTimeline.astro
const { journey } = Astro.props

const label = (m: any) =>
    m.endYear && m.endYear !== m.startYear
        ? `${m.startYear}–${m.endYear}`
        : `${m.startYear}`
---

<div class="relative w-full" data-journey>
    <!-- prev / next (desktop only — mobile swipes) -->
    <button
        type="button"
        data-journey-prev
        aria-label="Previous milestone"
        class="absolute -left-4 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-ink/10 bg-white text-ink shadow-md transition hover:bg-primary hover:text-white disabled:pointer-events-none disabled:opacity-0 md:flex lg:-left-6">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
        </svg>
    </button>
    <button
        type="button"
        data-journey-next
        aria-label="Next milestone"
        class="absolute -right-4 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-ink/10 bg-white text-ink shadow-md transition hover:bg-primary hover:text-white disabled:pointer-events-none disabled:opacity-0 md:flex lg:-right-6">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true">
            <path d="M9 18l6-6-6-6"></path>
        </svg>
    </button>

    <!-- track -->
    <ul
        data-journey-track
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4 pt-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {
            journey.map((m: any) => (
                <li
                    data-journey-card
                    class="group w-[78%] shrink-0 snap-start sm:w-[55%] lg:w-[calc((100%-3rem)/3)]">
                    {/* timeline rail + dot — negative margin bridges the gap between cards */}
                    <div class="-mx-3 flex items-center" aria-hidden="true">
                        <span class="h-px flex-1 bg-ink/15" />
                        <span class="mx-3 h-2.5 w-2.5 rounded-full bg-primary ring-4 ring-primary/15" />
                        <span class="h-px flex-1 bg-ink/15" />
                    </div>

                    <span class="mt-4 block text-sm font-semibold uppercase tracking-widest text-primary">
                        {label(m)}
                    </span>

                    <div class="mt-3 overflow-hidden rounded-2xl border border-ink/10 bg-sky-soft shadow-sm transition-all duration-300 md:group-hover:-translate-y-1.5 md:group-hover:shadow-xl">
                        <img
                            src={m.image}
                            alt={m.title}
                            class="aspect-[3/2] w-full object-cover transition-transform duration-500 md:group-hover:scale-105"
                            loading="lazy"
                        />
                    </div>

                    <h3 class="mt-4 font-semibold text-ink">{m.title}</h3>
                    <p class="mt-2 text-sm text-ink/70">{m.desc}</p>
                </li>
            ))
        }
    </ul>

    <!-- position dots -->
    <div class="mt-6 flex justify-center gap-2" data-journey-dots>
        {
            journey.map((m: any, i: number) => (
                <button
                    type="button"
                    data-journey-dot
                    data-index={i}
                    aria-label={`Go to ${label(m)} — ${m.title}`}
                    class="h-2 w-2 rounded-full bg-ink/20 transition-all"
                />
            ))
        }
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>("[data-journey]").forEach((root) => {
        const track = root.querySelector<HTMLElement>("[data-journey-track]")!
        const cards = Array.from(
            root.querySelectorAll<HTMLElement>("[data-journey-card]")
        )
        const dots = Array.from(
            root.querySelectorAll<HTMLButtonElement>("[data-journey-dot]")
        )
        const prev =
            root.querySelector<HTMLButtonElement>("[data-journey-prev]")!
        const next =
            root.querySelector<HTMLButtonElement>("[data-journey-next]")!

        if (!cards.length) return

        const step = () => {
            const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0
            return cards[0].getBoundingClientRect().width + gap
        }

        const activeIndex = () =>
            Math.min(
                cards.length - 1,
                Math.max(0, Math.round(track.scrollLeft / step()))
            )

        const scrollToIndex = (i: number) => {
            const clamped = Math.min(cards.length - 1, Math.max(0, i))
            track.scrollTo({ left: clamped * step(), behavior: "smooth" })
        }

        const syncControls = () => {
            const max = track.scrollWidth - track.clientWidth
            prev.disabled = track.scrollLeft <= 1
            next.disabled = track.scrollLeft >= max - 1

            const active = activeIndex()
            dots.forEach((dot, i) => {
                const on = i === active
                dot.classList.toggle("w-6", on)
                dot.classList.toggle("bg-primary", on)
                dot.classList.toggle("w-2", !on)
                dot.classList.toggle("bg-ink/20", !on)
                dot.setAttribute("aria-current", on ? "true" : "false")
            })
        }

        prev.addEventListener("click", () => scrollToIndex(activeIndex() - 1))
        next.addEventListener("click", () => scrollToIndex(activeIndex() + 1))
        dots.forEach((dot) =>
            dot.addEventListener("click", () =>
                scrollToIndex(Number(dot.dataset.index))
            )
        )

        let ticking = false
        track.addEventListener("scroll", () => {
            if (ticking) return
            ticking = true
            requestAnimationFrame(() => {
                syncControls()
                ticking = false
            })
        })
        window.addEventListener("resize", syncControls)
        syncControls()
    })
</script>
