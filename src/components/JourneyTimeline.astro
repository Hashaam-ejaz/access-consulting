---
// src/components/JourneyTimeline.astro
const { journey } = Astro.props;

const label = (m: any) => m.endYear && m.endYear !== m.startYear ? `${m.startYear}–${m.endYear}` : `${m.startYear}`;
---
<div class="relative mx-auto max-w-4xl">
  <!-- spine -->
  <div class="absolute left-8 top-0 h-full w-0.5 bg-ink/10 md:left-1/2 md:-translate-x-1/2"></div>

  <div class="flex flex-col gap-10 md:gap-16">
    {journey.map((m: any, i: number) => {
      const left = i % 2 === 0;
      return (
        <div class={`relative flex items-center ${left ? "md:flex-row" : "md:flex-row-reverse"}`}>
          <!-- dot + year on the spine -->
          <div class="absolute left-8 z-10 flex -translate-x-1/2 flex-col items-center md:left-1/2">
            <div class="h-5 w-5 rounded-full border-4 border-primary bg-white shadow"></div>
          </div>

          <!-- card -->
          <div class={`ml-20 w-[calc(100%-5rem)] md:ml-0 md:w-1/2 ${left ? "md:pr-12" : "md:pl-12"}`}>
            <div class="group overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl">
              <img src={m.image} alt={m.title} class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              <div class="p-5">
                <span class="text-sm font-semibold text-primary">{label(m)}</span>
                <h3 class="mt-1 font-semibold text-ink">{m.title}</h3>
                <p class="mt-2 text-sm text-ink/70">{m.desc}</p>
              </div>
            </div>
          </div>

          <!-- empty half on desktop -->
          <div class="hidden md:block md:w-1/2"></div>
        </div>
      );
    })}
  </div>
</div>