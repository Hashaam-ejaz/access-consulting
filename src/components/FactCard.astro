---
const { title, highlight = "", note = "" } = Astro.props
---

<div class="flex h-full flex-col rounded-2xl border border-ink/10 bg-white p-6">
    <h3 class="text-lg font-semibold text-ink">{title}</h3>
    {
        highlight && (
            <div class="mt-3 text-2xl font-semibold text-primary">
                {highlight}
            </div>
        )
    }
    <div class="mt-3 flex-1 text-ink/70">
        <slot />
    </div>
    {
        note && (
            <p class="mt-4 border-t border-ink/10 pt-3 text-sm text-ink/50">
                {note}
            </p>
        )
    }
</div>
