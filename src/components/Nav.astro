---
import { Image } from "astro:assets"

const items = [
    { name: "Home", href: "/" },
    { name: "About Us", href: "/about" },
    {
        name: "Services",
        children: [
            { name: "Consulting", href: "/consulting" },
            { name: "Standalone Services", href: "/services" },
            { name: "Study Abroad", href: "/study-abroad" },
            { name: "Careers & Work Visas", href: "/careers-visas" },
        ],
    },
    { name: "Proven Results", href: "/proven-results" },
    { name: "Blog", href: "/blog" },
    { name: "Contact", href: "/contact" },
]
---

<header
    class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-ink/5">
    <div class="mx-auto max-w-7xl px-6 py-3">
        <nav class="flex items-center justify-between gap-8">
            <a href="/" class="shrink-0">
                <Image
                    src="/logo.png"
                    alt="Access Consulting"
                    width={160}
                    height={48}
                    class="h-12 w-auto"
                />
            </a>

            <ul class="hidden items-center gap-6 lg:flex">
                {
                    items.map((item) =>
                        item.children ? (
                            <li class="group relative">
                                <button class="flex items-center gap-1 whitespace-nowrap text-md font-medium text-ink/80 transition-colors group-hover:text-primary">
                                    {item.name}
                                    <svg
                                        class="h-4 w-4 transition-transform group-hover:rotate-180"
                                        viewBox="0 0 20 20"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5">
                                        <path
                                            d="M5.2 7.5L10 12l4.8-4.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </button>
                                <div class="invisible absolute left-0 top-full pt-3 opacity-0 transition-all group-hover:visible group-hover:opacity-100">
                                    <ul class="w-52 rounded-xl border border-ink/10 bg-white p-2 shadow-lg">
                                        {item.children.map((child) => (
                                            <li>
                                                <a
                                                    href={child.href}
                                                    class="block rounded-lg px-3 py-2 text-sm font-medium text-ink/80 transition-colors hover:bg-sky-soft hover:text-primary">
                                                    {child.name}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </li>
                        ) : (
                            <li>
                                <a
                                    href={item.href}
                                    class="whitespace-nowrap text-md font-medium text-ink/80 transition-colors hover:text-primary">
                                    {item.name}
                                </a>
                            </li>
                        )
                    )
                }
            </ul>
            <a
                href="/consulting"
                class="hidden shrink-0 rounded-full bg-ink px-6
            py-2.5 text-sm font-medium text-white transition-colors duration-300
            hover:bg-primary lg:inline-block">
                Get Started
            </a>

            <button
                id="menu-open"
                aria-label="Open menu"
                aria-controls="mobile-menu"
                aria-expanded="false"
                class="flex h-10 w-10 items-center justify-center text-ink lg:hidden">
                <svg
                    width="24"
                    height="24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round">
                    <path d="M4 7h16M4 12h16M4 17h16"></path>
                </svg>
            </button>
        </nav>
    </div>
</header>

<div
    id="menu-backdrop"
    class="pointer-events-none fixed inset-0 z-40 bg-ink/50 opacity-0 transition-opacity duration-300 lg:hidden">
</div>

<aside
    id="mobile-menu"
    inert
    class="fixed right-0 top-0 z-50 flex h-full w-72 translate-x-full flex-col bg-white p-6 shadow-xl transition-transform duration-300 ease-out lg:hidden">
    <div class="mb-8 flex items-center justify-between">
        <span class="text-lg font-semibold text-ink">Access Consulting</span>
        <button
            id="menu-close"
            aria-label="Close menu"
            class="flex h-8 w-8 items-center justify-center text-ink">
            <svg
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round">
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>
    </div>

    <ul class="flex flex-col gap-1">
        {
            items.map((item) =>
                item.children ? (
                    <li>
                        <div class="px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-widest text-ink/40">
                            {item.name}
                        </div>
                        {item.children.map((child) => (
                            <a
                                href={child.href}
                                class="block rounded-lg px-3 py-3 text-base font-medium text-ink/80 transition-colors hover:bg-sky-soft hover:text-primary">
                                {child.name}
                            </a>
                        ))}
                    </li>
                ) : (
                    <li>
                        <a
                            href={item.href}
                            class="block rounded-lg px-3 py-3 text-base font-medium text-ink/80 transition-colors hover:bg-sky-soft hover:text-primary">
                            {item.name}
                        </a>
                    </li>
                )
            )
        }
    </ul>

    <a
        href="/consulting"
        class="mt-6 rounded-full bg-ink px-6 py-3 text-center
        text-sm font-medium text-white transition-colors hover:bg-primary">
        Get Started
    </a>
</aside>
<script>
    const openBtn = document.getElementById("menu-open")
    const closeBtn = document.getElementById("menu-close")
    const menu = document.getElementById("mobile-menu")
    const backdrop = document.getElementById("menu-backdrop")

    const open = () => {
        menu?.classList.remove("translate-x-full")
        menu?.removeAttribute("inert")
        backdrop?.classList.remove("opacity-0", "pointer-events-none")
        openBtn?.setAttribute("aria-expanded", "true")
        document.body.style.overflow = "hidden"
        closeBtn?.focus()
    }
    const close = () => {
        menu?.classList.add("translate-x-full")
        menu?.setAttribute("inert", "")
        backdrop?.classList.add("opacity-0", "pointer-events-none")
        openBtn?.setAttribute("aria-expanded", "false")
        document.body.style.overflow = ""
        openBtn?.focus()
    }

    openBtn?.addEventListener("click", open)
    closeBtn?.addEventListener("click", close)
    backdrop?.addEventListener("click", close)
    document.addEventListener("keydown", (e) => e.key === "Escape" && close())
</script>
