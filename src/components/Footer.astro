---
import { Image } from "astro:assets"

const linkGroups = [
    {
        title: "Services",
        links: [
            { name: "Study Abroad", href: "/study-abroad" },
            { name: "Ausbildung", href: "/careers-visas#ausbildung" },
            { name: "Careers & Work Visas", href: "/careers-visas" },
        ],
    },
    {
        title: "Consulting",
        links: [
            { name: "Consulting", href: "/consulting" },
            { name: "IELTS Preparation", href: "/consulting#ielts" },
            { name: "Book a Consultation", href: "/consulting" },
        ],
    },
    {
        title: "Company",
        links: [
            { name: "Proven Results", href: "/proven-results" },
            { name: "Blog", href: "/blog" },
            { name: "Contact", href: "/contact" },
        ],
    },
]

const offices = [
    { city: "Frankfurt, Germany", address: "Bromstraße, Frankfurt" },
    {
        city: "Gujranwala, Pakistan",
        address: "First Floor, Prisma Mall, Cantt, Gujranwala",
    },
    {
        city: "Rawalpindi, Pakistan (FES Partner Office)",
        address:
            "Office No 104-104A, 1st Floor, Kohistan Tower, Mehfooz Shaheed Road, Saddar, Rawalpindi",
    },
]

const socials = [
    { name: "Instagram", href: "https://instagram.com/AccessConsulting123" },
    { name: "LinkedIn", href: "https://www.linkedin.com/in/harrisazhar/" },
    { name: "YouTube", href: "https://youtube.com/@HarrisAzhar2807" },
    { name: "WhatsApp", href: "https://wa.me/4915772312591" },
    { name: "Gmail", href: "mailto:Harrisazhar130@gmail.com" },
]

const year = new Date().getFullYear()
---

<footer class="bg-ink text-white">
    <div class="mx-auto max-w-7xl px-6 py-16">
        <div class="flex flex-col gap-12 lg:flex-row lg:justify-between">
            <div class="lg:max-w-sm">
                <a href="/" class="inline-flex items-center gap-3">
                    <Image
                        src="/logo.png"
                        alt="Access Consulting"
                        width={160}
                        height={48}
                        class="h-11 w-auto brightness-0 invert"
                    />
                    <span class="text-xl font-semibold">Access Consulting</span>
                </a>

                <p class="mt-5 text-sm leading-relaxed text-white/60">
                    Premium international education and immigration consultancy.
                    Offices in Germany and Pakistan.
                </p>

                <ul class="mt-6 space-y-2.5 text-sm">
                    <li>
                        <a
                            href="tel:+4915772312591"
                            class="text-white/70 transition-colors hover:text-white">
                            +49 157 7231 2591 <span class="text-white/40">
                                (DE)
                            </span>
                        </a>
                    </li>
                    <li>
                        <a
                            href="mailto:accessventure130@gmail.com"
                            class="text-white/70 transition-colors hover:text-white">
                            accessventure130@gmail.com
                        </a>
                    </li>
                </ul>

                <div class="mt-6 flex gap-3">
                    {
                        socials.map((s) => (
                            <a
                                href={s.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={s.name}
                                class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/70 transition-colors hover:border-white/40 hover:text-white">
                                {s.name === "Instagram" && (
                                    <svg
                                        class="h-4 w-4"
                                        viewBox="0 0 24 24"
                                        fill="currentColor">
                                        <path d="M12 2c2.7 0 3 0 4.1.1 1 0 1.7.2 2.3.4.6.3 1.1.6 1.6 1.1s.8 1 1.1 1.6c.2.6.4 1.3.4 2.3.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c0 1-.2 1.7-.4 2.3-.3.6-.6 1.1-1.1 1.6s-1 .8-1.6 1.1c-.6.2-1.3.4-2.3.4-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1 0-1.7-.2-2.3-.4-.6-.3-1.1-.6-1.6-1.1s-.8-1-1.1-1.6c-.2-.6-.4-1.3-.4-2.3C2 15 2 14.7 2 12s0-3 .1-4.1c0-1 .2-1.7.4-2.3.3-.6.6-1.1 1.1-1.6s1-.8 1.6-1.1c.6-.2 1.3-.4 2.3-.4C9 2 9.3 2 12 2zm0 1.8c-2.7 0-3 0-4 .1-.8 0-1.2.2-1.5.3-.4.1-.7.3-1 .6s-.5.6-.6 1c-.1.3-.3.7-.3 1.5-.1 1-.1 1.3-.1 4s0 3 .1 4c0 .8.2 1.2.3 1.5.1.4.3.7.6 1s.6.5 1 .6c.3.1.7.3 1.5.3 1 .1 1.3.1 4 .1s3 0 4-.1c.8 0 1.2-.2 1.5-.3.4-.1.7-.3 1-.6s.5-.6.6-1c.1-.3.3-.7.3-1.5.1-1 .1-1.3.1-4s0-3-.1-4c0-.8-.2-1.2-.3-1.5-.1-.4-.3-.7-.6-1s-.6-.5-1-.6c-.3-.1-.7-.3-1.5-.3-1-.1-1.3-.1-4-.1zm0 3.1a5.1 5.1 0 110 10.2 5.1 5.1 0 010-10.2zm0 1.8a3.3 3.3 0 100 6.6 3.3 3.3 0 000-6.6zm5.3-.8a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" />
                                    </svg>
                                )}
                                {s.name === "LinkedIn" && (
                                    <svg
                                        class="h-4 w-4"
                                        viewBox="0 0 24 24"
                                        fill="currentColor">
                                        <path d="M4.98 3.5a2.5 2.5 0 11-.01 5.001A2.5 2.5 0 014.98 3.5zM3 8.98h4v12H3v-12zM9.5 8.98h3.8v1.64h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.78 2.65 4.78 6.1v6.32h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96v5.7h-4v-12z" />
                                    </svg>
                                )}
                                {s.name === "YouTube" && (
                                    <svg
                                        class="h-4 w-4"
                                        viewBox="0 0 24 24"
                                        fill="currentColor">
                                        <path d="M23 12s0-3.2-.4-4.7c-.2-.8-.9-1.5-1.7-1.7C19.4 5.2 12 5.2 12 5.2s-7.4 0-8.9.4c-.8.2-1.5.9-1.7 1.7C1 8.8 1 12 1 12s0 3.2.4 4.7c.2.8.9 1.5 1.7 1.7 1.5.4 8.9.4 8.9.4s7.4 0 8.9-.4c.8-.2 1.5-.9 1.7-1.7.4-1.5.4-4.7.4-4.7zM9.8 15.3V8.7l6.2 3.3-6.2 3.3z" />
                                    </svg>
                                )}
                                {s.name === "WhatsApp" && (
                                    <svg
                                        class="h-4 w-4"
                                        viewBox="0 0 24 24"
                                        fill="currentColor">
                                        <path d="M12 2a10 10 0 00-8.5 15.3L2 22l4.8-1.5A10 10 0 1012 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.8-.6-3-1.3-5-4.4-5.2-4.6-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.3.3c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.3.1.5.1.7-.1l.9-1c.2-.2.4-.2.6-.1l1.9 1c.3.1.4.2.5.3.1.2.1.8-.1 1.5z" />
                                    </svg>
                                )}
                                {s.name === "Gmail" && (
                                    <svg
                                        class="h-4 w-4"
                                        viewBox="0 0 24 24"
                                        fill="currentColor">
                                        <path d="M3 5h18a1 1 0 011 1v12a1 1 0 01-1 1H3a1 1 0 01-1-1V6a1 1 0 011-1zm.4 2L12 12.8 20.6 7H3.4zM20 8.5l-7.4 5a1 1 0 01-1.2 0L4 8.5V17h16V8.5z" />
                                    </svg>
                                )}
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- link columns -->
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:gap-14">
                {
                    linkGroups.map((group) => (
                        <div>
                            <h3 class="text-sm font-semibold uppercase tracking-wider text-white/40">
                                {group.title}
                            </h3>
                            <ul class="mt-4 space-y-3">
                                {group.links.map((link) => (
                                    <li>
                                        <a
                                            href={link.href}
                                            class="text-sm text-white/70 transition-colors hover:text-white">
                                            {link.name}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- offices -->
        <div class="mt-14 border-t border-white/10 pt-10">
            <h3
                class="text-sm font-semibold uppercase tracking-wider text-white/40">
                Our Offices
            </h3>
            <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    offices.map((office) => (
                        <div>
                            <div class="text-sm font-medium text-white">
                                {office.city}
                            </div>
                            <div class="mt-1 text-sm text-white/60">
                                {office.address}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- bottom bar -->
        <div class="mt-12 border-t border-white/10 pt-8 text-sm text-white/50">
            © {year} Access Consulting. All rights reserved.
        </div>
    </div>
</footer>
