---
const { image, caption, tag = "", alt = "" } = Astro.props
---

<figure
    class="overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-sm">
    <div class="relative bg-sky-soft">
        {
            tag && (
                <span class="absolute left-3 top-3 z-10 rounded-full bg-white/90 px-3 py-1 text-xs font-medium text-primary backdrop-blur">
                    {tag}
                </span>
            )
        }
        <img
            src={image}
            alt={alt || caption}
            class="w-full object-contain"
            loading="lazy"
        />
    </div>
    {
        caption && (
            <figcaption class="border-t border-ink/10 p-4 text-sm text-ink/70">
                {caption}
            </figcaption>
        )
    }
</figure>
