---
const { year, title, desc, image, alt = "", align = "left" } = Astro.props
---

<div
    class={`flex flex-col gap-6 md:flex-row md:items-center ${align === "right" ? "md:flex-row-reverse" : ""}`}>
    <!-- image -->
    <div class="md:w-1/2">
        <div class="overflow-hidden rounded-2xl bg-sky-soft">
            <img
                src={image}
                alt={alt || title}
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
            />
        </div>
    </div>
    <!-- text -->
    <div class="md:w-1/2">
        <span
            class="text-sm font-semibold uppercase tracking-widest text-primary">
            {year}
        </span>
        <h3 class="mt-2 text-xl font-semibold text-ink md:text-2xl">{title}</h3>
        <p class="mt-3 text-ink/70">{desc}</p>
    </div>
</div>
