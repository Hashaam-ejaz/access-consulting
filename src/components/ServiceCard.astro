---
// src/components/ServiceCard.astro
const {
    title,
    desc,
    price = "",
    turnaround = "",
    ctaLabel = "Enquire",
    ctaHref = "/consulting#evaluate",
    icon = "",
    includes = [],
} = Astro.props
---

<div class="flex h-full flex-col rounded-2xl border border-ink/10 bg-white p-6">
    {icon && <div class="mb-4 text-3xl">{icon}</div>}
    <h3 class="text-lg font-semibold text-ink">{title}</h3>
    <p class="mt-2 text-sm text-ink/70">{desc}</p>

    {
        includes.length > 0 && (
            <ul class="mt-4 space-y-2">
                {includes.map((item: string) => (
                    <li class="flex gap-2 text-sm text-ink/70">
                        <span class="mt-0.5 text-primary">✓</span>
                        <span>{item}</span>
                    </li>
                ))}
            </ul>
        )
    }

    <div class="mt-6 flex-1"></div>

    <div class="border-t border-ink/10 pt-4">
        <div class="flex items-baseline justify-between">
            <span class="text-lg font-semibold text-primary">
                {price || "Contact for pricing"}
            </span>
            {
                turnaround && (
                    <span class="text-xs text-ink/50">{turnaround}</span>
                )
            }
        </div>
        <a
            href={ctaHref}
            target="_blank"
            class="mt-4 block rounded-full bg-ink px-6 py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-primary">
            {ctaLabel}
        </a>
    </div>
</div>
