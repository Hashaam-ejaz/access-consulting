{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "access-consulting",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars" :
	{
		"SHEET_WEBHOOK_URL" : "https://script.google.com/macros/s/AKfycbzsLpP6akAO3YvAOwZyINUQT0VcCYSrczr5wqhQFVDpgjKK_ZoAugv-9aitJeMHNdhbmA/exec"
	}

}